{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sathuri",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "sathuri", "database_id": "af807c54-3bd2-4702-baa5-c72366b64ef1" }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "DAILY_GLOBAL": "200",
    "DAILY_PER_IP": "15"
  }
}
